{
  "client": "openrouter",
  "python_bin": "./.venv/bin/python",
  "main_script": "main.py",
  "copy_env": ["OPENROUTER_API_KEY"],
  "models": ["anthropic/claude-sonnet-4.6", "qwen/qwen3.6-plus"],
  "experiments": ["paper/e1", "paper/e2", "paper/e3", "paper/e4", "paper/e5"],
  "shared_args": {"mujoco.headless": true, "seed": 123},
  "launcher": {
    "terminal_app": "Terminal",
    "keep_open": true,
    "pause_seconds_between_launches": 0.2,
    "log_dir": "logs/paper_matrix"
  }
}

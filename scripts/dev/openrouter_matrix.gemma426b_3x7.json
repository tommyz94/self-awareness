{
  "client": "openrouter",
  "python_bin": "./.venv/bin/python",
  "main_script": "main.py",
  "copy_env": [
    "OPENROUTER_API_KEY"
  ],
  "env_vars": {
    "PYTHONUNBUFFERED": "1"
  },
  "models": [
    "google/gemma-4-26b-a4b-it:nitro"
  ],
  "experiments": [
